// ─────────────────────────────────────────────────────────────────────────────
//  src/utils/api.ht
//  YouTube Music InnerTube API — constants & HTTP helpers
// ─────────────────────────────────────────────────────────────────────────────
import "module:spotube_plugin" as spotube

// Public InnerTube API key (same for all YouTube Music clients)
let API_KEY = "AIzaSyC9XL3ZjWddXya6X74dJoCTL-WEYFDNX30"
let API_BASE = "https://music.youtube.com/youtubei/v1"

// YouTube Music search filter params (base-64–encoded protobuf blobs)
let SEARCH_SONGS      = "EgWKAQIIAWoKEAkQBRAKEAMQBA=="
let SEARCH_ALBUMS     = "EgWKAQIYAWoKEAkQBRAKEAMQBA=="
let SEARCH_ARTISTS    = "EgWKAQIgAWoKEAkQBRAKEAMQBA=="
let SEARCH_PLAYLISTS  = "EgWKAQIoAWoKEAkQBRAKEAMQBA=="

// Browse IDs used to navigate named "pages" inside YTMusic
let BROWSE_HOME            = "FEmusic_home"
let BROWSE_CHARTS          = "FEmusic_charts"
let BROWSE_LIKED_SONGS     = "FEmusic_liked_videos"
let BROWSE_LIKED_PLAYLISTS = "FEmusic_liked_playlists"
let BROWSE_LIBRARY_ARTISTS = "FEmusic_library_privately_likes_artists"
let BROWSE_LIBRARY_ALBUMS  = "FEmusic_library_privately_likes_albums"

// ─────────────────────────────────────────────────────────────────────────────
//  Build the InnerTube "context" block that every request requires
// ─────────────────────────────────────────────────────────────────────────────
fun makeContext() {
  return {
    "client": {
      "clientName":    "WEB_REMIX",
      "clientVersion": "1.20241112.01.00",
      "hl": "en",
      "gl": "US",
      "platform": "DESKTOP",
      "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }
  }
}

// ─────────────────────────────────────────────────────────────────────────────
//  Build HTTP headers.
//  Pass cookieStr = "" for unauthenticated (public) calls.
// ─────────────────────────────────────────────────────────────────────────────
fun makeHeaders(cookieStr) {
  var headers = {
    "Content-Type":              "application/json",
    "X-Goog-Api-Format-Version": "1",
    "Accept":                    "*/*",
    "Accept-Language":           "en-US,en;q=0.9",
    "Origin":                    "https://music.youtube.com",
    "Referer":                   "https://music.youtube.com/",
    "User-Agent":                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
  }

  if (cookieStr != null && cookieStr != "") {
    // Cookie-based authentication — all session cookies from the WebView login
    headers["Cookie"]          = cookieStr
    headers["X-Goog-AuthUser"] = "0"
    headers["X-Origin"]        = "https://music.youtube.com"
  }

  return headers
}

// ─────────────────────────────────────────────────────────────────────────────
//  POST helper — attaches context, fires request
// ─────────────────────────────────────────────────────────────────────────────
fun ytPost(client, endpoint, body, cookieStr) {
  let url = "${API_BASE}/${endpoint}?key=${API_KEY}&prettyPrint=false"
  body["context"] = makeContext()
  return client.post(url, headers: makeHeaders(cookieStr), body: body)
}

// ─────────────────────────────────────────────────────────────────────────────
//  GET helper (used for Google userinfo endpoint, etc.)
// ─────────────────────────────────────────────────────────────────────────────
fun ytGet(client, url, cookieStr) {
  return client.get(url, headers: makeHeaders(cookieStr))
}

// ─────────────────────────────────────────────────────────────────────────────
//  Read the session cookie string from LocalStorage.
//  Returns a Future<String> — empty string means the user is not signed in.
// ─────────────────────────────────────────────────────────────────────────────
fun getStoredCookies() {
  return spotube.LocalStorage.getString("ytmusic_cookies").then((v) {
    if (v == null) return ""
    return v
  })
}

// ─────────────────────────────────────────────────────────────────────────────
//  Build a SpotubePaginationResponseObject map
// ─────────────────────────────────────────────────────────────────────────────
fun makePagination(items, total, offset, limit, next) {
  return {
    "items":  items,
    "total":  total,
    "offset": offset,
    "limit":  limit,
    "next":   next
  }
}
