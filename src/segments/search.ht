// src/segments/search.ht — Search across all YouTube Music content types
import "../utils/api.ht"
import "../utils/parser.ht"

class SearchEndpoint {
  var client

  // Chips shown in the Spotube search UI
  get chips => ["all", "tracks", "albums", "artists", "playlists"]

  construct(this.client) {}

  fun _cookies() { return getStoredCookies() }

  fun _doSearch(query, params) {
    return _cookies().then((cookies) {
      var body = {"query": query}
      if (params != null && params != "") body["params"] = params
      return ytPost(client, "search", body, cookies)
    })
  }

  // ── all() — returns SpotubeSearchResponseObject ────────────────────────────
  fun all(query) {
    return _doSearch(query, null).then((resp) {
      return _parseSearchResponse(resp)
    })
  }

  fun tracks(query, {offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 20
    return _doSearch(query, SEARCH_SONGS).then((resp) {
      var items = _parseSingleType(resp, parseTrack)
      return makePagination(_slice(items, offset, limit), items.length, offset, limit, null)
    })
  }

  fun albums(query, {offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 20
    return _doSearch(query, SEARCH_ALBUMS).then((resp) {
      var items = _parseSingleType(resp, parseAlbum)
      return makePagination(_slice(items, offset, limit), items.length, offset, limit, null)
    })
  }

  fun artists(query, {offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 20
    return _doSearch(query, SEARCH_ARTISTS).then((resp) {
      var items = _parseSingleType(resp, parseArtist)
      return makePagination(_slice(items, offset, limit), items.length, offset, limit, null)
    })
  }

  fun playlists(query, {offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 20
    return _doSearch(query, SEARCH_PLAYLISTS).then((resp) {
      var items = _parseSingleType(resp, parsePlaylist)
      return makePagination(_slice(items, offset, limit), items.length, offset, limit, null)
    })
  }

  // ── private ───────────────────────────────────────────────────────────────

  fun _getTabContents(resp) {
    if (resp == null) return null
    var tabbed = safeGet(safeGet(resp, "contents"), "tabbedSearchResultsRenderer")
    if (tabbed == null) return null
    var tabs = safeGet(tabbed, "tabs") ?? []
    if (tabs.length == 0) return null
    var tabContent  = safeGet(safeGet(tabs[0], "tabRenderer"), "content")
    var sectionList = safeGet(tabContent, "sectionListRenderer")
    if (sectionList == null) return null
    return safeGet(sectionList, "contents")
  }

  fun _parseSearchResponse(resp) {
    var trackItems    = []
    var albumItems    = []
    var artistItems   = []
    var playlistItems = []

    var sections = _getTabContents(resp)
    if (sections != null) {
      for (var section in sections) {
        var shelf = safeGet(section, "musicShelfRenderer")
        if (shelf == null) continue

        var title = textFromRuns(safeGet(safeGet(shelf, "title"), "runs")) ?? ""
        var lt    = title.toLowerCase()
        var contents = safeGet(shelf, "contents") ?? []

        for (var item in contents) {
          var r = safeGet(item, "musicResponsiveListItemRenderer")
               ?? safeGet(item, "musicTwoRowItemRenderer")
          if (r == null) continue

          if (lt.contains("song") || lt.contains("track")) {
            var t = parseTrack(r)
            if (t != null) trackItems.add(t)
          } else if (lt.contains("album") || lt.contains("single") || lt.contains("ep")) {
            var a = parseAlbum(r)
            if (a != null) albumItems.add(a)
          } else if (lt.contains("artist")) {
            var ar = parseArtist(r)
            if (ar != null) artistItems.add(ar)
          } else if (lt.contains("playlist") || lt.contains("community") || lt.contains("featured")) {
            var pl = parsePlaylist(r)
            if (pl != null) playlistItems.add(pl)
          } else {
            // Top result shelf — try track first
            var t = parseTrack(r)
            if (t != null) trackItems.add(t)
          }
        }
      }
    }

    return {
      "tracks":    makePagination(trackItems,    trackItems.length,    0, 20, null),
      "albums":    makePagination(albumItems,    albumItems.length,    0, 20, null),
      "artists":   makePagination(artistItems,   artistItems.length,   0, 20, null),
      "playlists": makePagination(playlistItems, playlistItems.length, 0, 20, null)
    }
  }

  fun _parseSingleType(resp, parseFun) {
    var items    = []
    var sections = _getTabContents(resp)
    if (sections == null) return items
    for (var section in sections) {
      var shelf = safeGet(section, "musicShelfRenderer")
      if (shelf == null) continue
      var contents = safeGet(shelf, "contents") ?? []
      for (var item in contents) {
        var r = safeGet(item, "musicResponsiveListItemRenderer")
             ?? safeGet(item, "musicTwoRowItemRenderer")
        if (r == null) continue
        var parsed = parseFun(r)
        if (parsed != null) items.add(parsed)
      }
    }
    return items
  }

  fun _slice(list, offset, limit) {
    var out = []
    var i   = offset < list.length ? offset : list.length
    var end = (offset + limit) < list.length ? (offset + limit) : list.length
    while (i < end) { out.add(list[i]); i = i + 1 }
    return out
  }
}
