// ─────────────────────────────────────────────────────────────────────────────
//  src/segments/auth.ht
//  AuthEndpoint — opens the official music.youtube.com sign-in page inside a
//  Spotube-managed WebView, waits for the user to complete Google login, then
//  captures the session cookies that all authenticated API calls will reuse.
//
//  Authentication flow
//  ───────────────────
//  1.  User taps "Sign In" inside Spotube.
//  2.  Spotube calls authenticate() → we open a full-screen WebView at
//      https://accounts.google.com/ServiceLogin?service=youtube
//  3.  User completes Google's normal sign-in UI (email → password → 2FA, etc.)
//  4.  Google redirects back to music.youtube.com; our URL-change listener
//      fires, we call getCookies("https://music.youtube.com") and look for
//      the SAPISID cookie that proves a successful login.
//  5.  All cookies are stored in LocalStorage; we emit a "login" event and
//      close the WebView.
//
//  Cookie-based sessions do not expire quickly — YouTube sessions typically
//  last 6–12 months.  If a cookie is missing the user is prompted to log in
//  again (isAuthenticated returns false).
// ─────────────────────────────────────────────────────────────────────────────
import "module:spotube_plugin" as spotube
import "module:hetu_std"       as std

// Google sign-in URL — redirects straight into YouTube Music after auth
let GOOGLE_SIGNIN_URL = "https://accounts.google.com/ServiceLogin?service=youtube&uilel=3&passive=true&continue=https://www.youtube.com/signin?action_handle_signin=true%26next=%2F"

class AuthEndpoint {
  var client                 // HttpClient provided by Spotube
  var controller             // StreamController — drives Spotube's auth UI
  var _sapisid     = ""
  var _cookieStr   = ""
  var _webview     = null
  var _sub         = null    // URL-change subscription handle

  // ── Required by Spotube ──────────────────────────────────────────────────
  get authStateStream -> std.Stream => controller.stream

  construct(this.client) {
    controller = std.StreamController.broadcast()
    _restoreSession()
  }

  // ── Try to load a previously saved session from LocalStorage ─────────────
  fun _restoreSession() {
    spotube.LocalStorage.getString("ytmusic_sapisid").then((sapisid) {
      if (sapisid == null || sapisid == "") return null

      _sapisid = sapisid
      spotube.LocalStorage.getString("ytmusic_cookies").then((cookies) {
        if (cookies != null && cookies != "") {
          _cookieStr = cookies
        }
        // Tell Spotube "we have a valid session already"
        controller.add({type: "recovered"}.toJson())
      })
    })
  }

  // ── Returns true when we have a SAPISID cookie in memory ─────────────────
  fun isAuthenticated() -> bool {
    return _sapisid != null && _sapisid != ""
  }

  // ── Main entry-point — called by Spotube when the user requests sign-in ──
  fun authenticate() -> std.Future {
    _webview = spotube.Webview(uri: GOOGLE_SIGNIN_URL)

    // Listen for every URL change inside the WebView
    _sub = _webview.onUrlRequestStream().listen((url) {
      // After a successful Google login the browser ends up on YouTube Music
      if (_isYtMusicUrl(url)) {
        // Give the page a moment to finalise all Set-Cookie headers
        _captureSession()
      }
    })

    // Open the WebView — this returns immediately; the sign-in is async
    return _webview.open()
  }

  // ── Called once we detect a YouTube Music URL in the WebView ─────────────
  fun _captureSession() {
    _webview.getCookies("https://music.youtube.com").then((cookies) {
      var sapisid = null
      var parts   = []

      for (var cookie in cookies) {
        var name  = cookie["name"]  ?? ""
        var value = cookie["value"] ?? ""
        if (name == "" || value == "") continue

        parts.add("${name}=${value}")

        if (name == "SAPISID") sapisid = value
      }

      // We need at least the SAPISID to consider the user "signed in"
      if (sapisid == null || sapisid == "") return null

      // ── Persist ──────────────────────────────────────────────────────────
      _sapisid   = sapisid
      _cookieStr = parts.join("; ")

      spotube.LocalStorage.setString("ytmusic_sapisid", _sapisid)
      spotube.LocalStorage.setString("ytmusic_cookies", _cookieStr)

      // ── Clean up & notify ─────────────────────────────────────────────────
      _cleanup()
      controller.add({type: "login"}.toJson())
    })
  }

  // ── Returns true for URLs that indicate the user is on YouTube Music ──────
  fun _isYtMusicUrl(url) -> bool {
    if (url == null) return false
    return url.contains("music.youtube.com")
        && !url.contains("accounts.google.com")
        && !url.contains("myaccount.google.com")
  }

  // ── Cancel subscription and close WebView ─────────────────────────────────
  fun _cleanup() {
    if (_sub != null) {
      _sub.cancel()
      _sub = null
    }
    if (_webview != null) {
      _webview.close()
      _webview = null
    }
  }

  // ── Sign out — wipe LocalStorage & emit logout event ─────────────────────
  fun logout() -> std.Future {
    _sapisid   = ""
    _cookieStr = ""
    spotube.LocalStorage.setString("ytmusic_sapisid", "")
    spotube.LocalStorage.setString("ytmusic_cookies",  "")
    controller.add({type: "logout"}.toJson())
    return std.Future.value(null)
  }
}
