// ─────────────────────────────────────────────────────────────────────────────
//  src/segments/playlist.ht
//  PlaylistEndpoint — fetch, create, edit, and delete playlists;
//  add / remove tracks; save / unsave from library
// ─────────────────────────────────────────────────────────────────────────────
import "../utils/api.ht"
import "../utils/parser.ht"

let ACTION_SET_PLAYLIST_NAME             = "ACTION_SET_PLAYLIST_NAME"
let ACTION_SET_PLAYLIST_DESCRIPTION      = "ACTION_SET_PLAYLIST_DESCRIPTION"
let ACTION_ADD_VIDEO                     = "ACTION_ADD_VIDEO"
let ACTION_REMOVE_VIDEO_BY_VIDEO_ID      = "ACTION_REMOVE_VIDEO_BY_VIDEO_ID"
let ACTION_ADD_PLAYLIST                  = "ACTION_ADD_PLAYLIST"
let ACTION_REMOVE_PLAYLIST_BY_PLAYLIST_ID = "ACTION_REMOVE_PLAYLIST_BY_PLAYLIST_ID"

class PlaylistEndpoint {
  var client

  construct(this.client) {}

  fun _cookies() { return getStoredCookies() }

  // ── getPlaylist(id, {offset, limit}) ──────────────────────────────────────
  fun getPlaylist(id, {offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 50

    return _cookies().then((cookies) {
      // YTMusic browse ID for playlists is "VL" + playlistId
      return ytPost(client, "browse", {"browseId": "VL${id}"}, cookies).then((resp) {
        if (resp == null) return null
        return _parsePlaylistPage(resp, id, offset, limit)
      })
    })
  }

  // ── create(userId, name) ──────────────────────────────────────────────────
  fun create(userId, name) {
    if (name == null || name == "") name = "New Playlist"
    return _cookies().then((cookies) {
      if (cookies == "") return null
      return ytPost(client, "playlist/create", {"title": name}, cookies)
    })
  }

  // ── update(playlistId, name, description) ─────────────────────────────────
  fun update(playlistId, name, description) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      var actions = []
      if (name != null && name != "") {
        actions.add({"action": ACTION_SET_PLAYLIST_NAME, "playlistName": name})
      }
      if (description != null) {
        actions.add({"action": ACTION_SET_PLAYLIST_DESCRIPTION, "playlistDescription": description})
      }
      if (actions.length == 0) return null
      return ytPost(client, "browse/edit_playlist", {
        "playlistId": playlistId,
        "actions":    actions
      }, cookies)
    })
  }

  // ── deletePlaylist(id) ────────────────────────────────────────────────────
  fun deletePlaylist(id) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      return ytPost(client, "playlist/delete", {"playlistId": id}, cookies)
    })
  }

  // ── addTracks(playlistId, tracks, position) ───────────────────────────────
  fun addTracks(playlistId, tracks, {position}) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      var actions = []
      for (var t in tracks) {
        var videoId = t["id"] ?? t
        var action  = {"action": ACTION_ADD_VIDEO, "addedVideoId": videoId}
        if (position != null) action["position"] = position
        actions.add(action)
      }
      return ytPost(client, "browse/edit_playlist", {
        "playlistId": playlistId,
        "actions":    actions
      }, cookies)
    })
  }

  // ── removeTracks(playlistId, tracks) ─────────────────────────────────────
  fun removeTracks(playlistId, tracks) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      var actions = []
      for (var t in tracks) {
        var videoId = t["id"] ?? t
        actions.add({"action": ACTION_REMOVE_VIDEO_BY_VIDEO_ID, "removedVideoId": videoId})
      }
      return ytPost(client, "browse/edit_playlist", {
        "playlistId": playlistId,
        "actions":    actions
      }, cookies)
    })
  }

  // ── save(playlistIds) — add playlists to library ──────────────────────────
  fun save(playlistIds) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      var actions = []
      for (var id in playlistIds) {
        actions.add({"action": ACTION_ADD_PLAYLIST, "addedFullListId": id})
      }
      return ytPost(client, "browse/edit_playlist", {
        "playlistId": BROWSE_LIKED_PLAYLISTS,
        "actions":    actions
      }, cookies)
    })
  }

  // ── unsave(playlistIds) — remove playlists from library ───────────────────
  fun unsave(playlistIds) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      var actions = []
      for (var id in playlistIds) {
        actions.add({"action": ACTION_REMOVE_PLAYLIST_BY_PLAYLIST_ID, "removedFullListId": id})
      }
      return ytPost(client, "browse/edit_playlist", {
        "playlistId": BROWSE_LIKED_PLAYLISTS,
        "actions":    actions
      }, cookies)
    })
  }

  // ── Private helpers ───────────────────────────────────────────────────────

  fun _parsePlaylistPage(resp, id, offset, limit) {
    var header = safeGet(resp, "header")
    var hdr    = safeGet(header, "musicDetailHeaderRenderer")
             ?? safeGet(header, "musicImmersiveHeaderRenderer")

    var title       = "Unknown Playlist"
    var description = null
    var images      = []

    if (hdr != null) {
      title       = textFromRuns(safeGet(safeGet(hdr, "title"),       "runs")) ?? "Unknown Playlist"
      description = textFromRuns(safeGet(safeGet(hdr, "description"), "runs"))
      images      = parseThumbnails(safeGet(hdr, "thumbnail"))
    }

    var allTracks = _parsePlaylistTracks(resp)

    var pageItems = []
    var i   = offset < allTracks.length ? offset : allTracks.length
    var end = (offset + limit) < allTracks.length ? (offset + limit) : allTracks.length
    while (i < end) {
      pageItems.add(allTracks[i])
      i = i + 1
    }

    return {
      "id":          id,
      "name":        title,
      "description": description,
      "images":      images,
      "public":      true,
      "tracks":      makePagination(pageItems, allTracks.length, offset, limit, null),
      "owner":       {"display_name": "YouTube Music", "id": ""},
      "collaborative": false,
      "external_urls": {"youtube": "https://music.youtube.com/playlist?list=${id}"}
    }
  }

  fun _parsePlaylistTracks(resp) {
    var tracks   = []
    var sections = getSectionContents(resp)
    if (sections == null) return tracks
    for (var section in sections) {
      var shelf    = safeGet(section, "musicShelfRenderer")
      if (shelf == null) continue
      var contents = safeGet(shelf, "contents") ?? []
      for (var item in contents) {
        var r = safeGet(item, "musicResponsiveListItemRenderer")
        if (r == null) continue
        var t = parseTrack(r)
        if (t != null) tracks.add(t)
      }
    }
    return tracks
  }
}
