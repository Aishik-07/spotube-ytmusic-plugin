// src/segments/playlist.ht — YouTube Music playlist CRUD
import "../utils/api.ht"
import "../utils/parser.ht"

class PlaylistEndpoint {
  var client

  construct(this.client) {}

  fun _cookies() { return getStoredCookies() }

  fun getPlaylist(id) {
    return _cookies().then((cookies) {
      var browseId = id.startsWith("VL") ? id : "VL${id}"
      return ytPost(client, "browse", {"browseId": browseId}, cookies).then((resp) {
        if (resp == null) return null
        return _parsePlaylistPage(resp, id)
      })
    })
  }

  fun tracks(id, {offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 50
    return getPlaylist(id).then((pl) {
      if (pl == null) return makePagination([], 0, offset, limit, null)
      var all  = safeGet(safeGet(pl, "tracks"), "items") ?? []
      var page = _slice(all, offset, limit)
      return makePagination(page, all.length, offset, limit, null)
    })
  }

  fun create(userId, {name, description, public, collaborative}) {
    name          = name ?? "New Playlist"
    description   = description ?? ""
    public        = public ?? true
    collaborative = collaborative ?? false
    return _cookies().then((cookies) {
      if (cookies == "") return null
      return ytPost(client, "playlist/create", {
        "title": name, "description": description
      }, cookies).then((resp) {
        if (resp == null) return null
        var pid = safeGet(resp, "playlistId") ?? ""
        return {
          "id": pid, "name": name, "images": [],
          "description": description,
          "tracks": makePagination([], 0, 0, 0, null),
          "owner": null, "public": public, "collaborative": collaborative,
          "external_urls": {"youtube": "https://music.youtube.com/playlist?list=${pid}"}
        }
      })
    })
  }

  fun update(playlistId, {name, description, public, collaborative}) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      var actions = []
      if (name != null) actions.add({"action": "ACTION_SET_PLAYLIST_NAME", "playlistName": name})
      if (description != null) actions.add({"action": "ACTION_SET_PLAYLIST_DESCRIPTION", "playlistDescription": description})
      return ytPost(client, "browse/edit_playlist", {"playlistId": playlistId, "actions": actions}, cookies).then((_) => null)
    })
  }

  fun deletePlaylist(playlistId) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      return ytPost(client, "playlist/delete", {"playlistId": playlistId}, cookies).then((_) => null)
    })
  }

  fun addTracks(playlistId, {trackIds, position}) {
    trackIds = trackIds ?? []
    return _cookies().then((cookies) {
      if (cookies == "") return null
      var actions = []
      for (var id in trackIds) {
        actions.add({"action": "ACTION_ADD_VIDEO", "addedVideoId": id})
      }
      return ytPost(client, "browse/edit_playlist", {"playlistId": playlistId, "actions": actions}, cookies).then((_) => null)
    })
  }

  fun removeTracks(playlistId, {trackIds}) {
    trackIds = trackIds ?? []
    return _cookies().then((cookies) {
      if (cookies == "") return null
      var actions = []
      for (var id in trackIds) {
        actions.add({"action": "ACTION_REMOVE_VIDEO_BY_VIDEO_ID", "removedVideoId": id})
      }
      return ytPost(client, "browse/edit_playlist", {"playlistId": playlistId, "actions": actions}, cookies).then((_) => null)
    })
  }

  fun save(playlistId) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      return ytPost(client, "browse/edit_playlist", {
        "playlistId": "LIKED_PLAYLISTS",
        "actions": [{"action": "ACTION_ADD_PLAYLIST", "addedFullListId": playlistId}]
      }, cookies).then((_) => null)
    })
  }

  fun unsave(playlistId) {
    return _cookies().then((cookies) {
      if (cookies == "") return null
      return ytPost(client, "browse/edit_playlist", {
        "playlistId": "LIKED_PLAYLISTS",
        "actions": [{"action": "ACTION_REMOVE_PLAYLIST_BY_PLAYLIST_ID", "removedFullListId": playlistId}]
      }, cookies).then((_) => null)
    })
  }

  // ── private ───────────────────────────────────────────────────────────────

  fun _parsePlaylistPage(resp, id) {
    var header = safeGet(resp, "header")
    var hdr    = safeGet(header, "musicDetailHeaderRenderer")
             ?? safeGet(header, "musicImmersiveHeaderRenderer")
    if (hdr == null) return null

    var title  = textFromRuns(safeGet(safeGet(hdr, "title"),       "runs")) ?? "Unknown Playlist"
    var desc   = textFromRuns(safeGet(safeGet(hdr, "description"), "runs"))
    var images = parseThumbnails(safeGet(hdr, "thumbnail"))
    var items  = _parsePlaylistTracks(resp)

    return {
      "id": id, "name": title, "images": images, "description": desc,
      "tracks": makePagination(items, items.length, 0, items.length, null),
      "owner": null, "public": true, "collaborative": false,
      "external_urls": {"youtube": "https://music.youtube.com/playlist?list=${id}"}
    }
  }

  fun _parsePlaylistTracks(resp) {
    var tracks   = []
    var sections = getSectionContents(resp)
    if (sections == null) return tracks
    for (var section in sections) {
      var shelf = safeGet(section, "musicShelfRenderer")
      if (shelf == null) continue
      var contents = safeGet(shelf, "contents") ?? []
      for (var item in contents) {
        var r = safeGet(item, "musicResponsiveListItemRenderer")
        if (r == null) continue
        var t = parseTrack(r)
        if (t != null) tracks.add(t)
      }
    }
    return tracks
  }

  fun _slice(list, offset, limit) {
    var out = []
    var i   = offset < list.length ? offset : list.length
    var end = (offset + limit) < list.length ? (offset + limit) : list.length
    while (i < end) { out.add(list[i]); i = i + 1 }
    return out
  }
}
