// ─────────────────────────────────────────────────────────────────────────────
//  src/segments/browse.ht
//  BrowseEndpoint — YouTube Music home feed and browse carousels
// ─────────────────────────────────────────────────────────────────────────────
import "../utils/api.ht"
import "../utils/parser.ht"

class BrowseEndpoint {
  var client

  construct(this.client) {}

  fun _cookies() { return getStoredCookies() }

  // ── home({offset, limit}) → SpotubePaginationResponseObject ──────────────
  fun home({offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 20

    return _cookies().then((cookies) {
      return ytPost(client, "browse", {"browseId": BROWSE_HOME}, cookies).then((resp) {
        if (resp == null) return makePagination([], 0, offset, limit, null)
        var sections = _parseHomeSections(resp, offset, limit)
        return makePagination(sections, sections.length + offset, offset, limit, null)
      })
    })
  }

  // ── Private helpers ───────────────────────────────────────────────────────

  fun _parseHomeSections(resp, offset, limit) {
    var sectionItems = []
    var sections     = getSectionContents(resp)
    if (sections == null) return sectionItems

    for (var section in sections) {
      // Standard music carousel shelf
      var carousel = safeGet(section, "musicCarouselShelfRenderer")
      if (carousel != null) {
        var parsed = _parseCarousel(carousel)
        if (parsed != null) sectionItems.add(parsed)
        continue
      }

      // Immersive carousel (featured banner style)
      var immersive = safeGet(section, "musicImmersiveCarouselShelfRenderer")
      if (immersive != null) {
        var parsed = _parseCarousel(immersive)
        if (parsed != null) sectionItems.add(parsed)
        continue
      }

      // Grid items (e.g. moods, genres)
      var grid = safeGet(section, "gridRenderer")
      if (grid != null) {
        var gridItems = safeGet(grid, "items") ?? []
        var out       = _parseBrowseGridItems(gridItems, parseAlbum)
        if (out.length > 0) {
          sectionItems.add({"title": "Grid", "items": out})
        }
        continue
      }
    }

    return sectionItems
  }

  fun _parseCarousel(carousel) {
    var hdr    = safeGet(carousel, "header")
    var hdrRender = safeGet(hdr, "musicCarouselShelfBasicHeaderRenderer")
             ?? safeGet(hdr, "musicImmersiveCarouselShelfBasicHeaderRenderer")

    var title     = "Featured"
    var sectionId = null
    var browseMore = null

    if (hdrRender != null) {
      title = textFromRuns(safeGet(safeGet(hdrRender, "title"), "runs")) ?? "Featured"

      // "More" button for pagination
      var moreBtn = safeGet(safeGet(hdrRender, "moreContentButton"), "buttonRenderer")
      if (moreBtn != null) {
        var moreId = safeGet(safeGet(safeGet(moreBtn, "navigationEndpoint"), "browseEndpoint"), "browseId")
        if (moreId != null) browseMore = moreId
      }
    }

    var contents = safeGet(carousel, "contents") ?? []
    var items    = []

    for (var item in contents) {
      var parsed = _parseCarouselItem(item)
      if (parsed != null) items.add(parsed)
    }

    if (items.length == 0) return null

    var data = {"title": title, "items": items}
    if (browseMore != null) data["browseMore"] = browseMore
    return data
  }

  fun _parseCarouselItem(item) {
    var r = safeGet(item, "musicTwoRowItemRenderer")
    if (r != null) {
      // Try album first
      var a = parseAlbum(r)
      if (a != null) return a
      // Then artist
      var ar = parseArtist(r)
      if (ar != null) return ar
      // Then playlist
      var pl = parsePlaylist(r)
      return pl
    }

    // Responsive list item (tracks in featured lists)
    var lr = safeGet(item, "musicResponsiveListItemRenderer")
    if (lr != null) {
      var t = parseTrack(lr)
      return t
    }

    return null
  }

  fun _parseBrowseGridItems(gridItems, parseFun) {
    var out = []
    for (var item in gridItems) {
      var r = safeGet(item, "musicTwoRowItemRenderer")
             ?? safeGet(item, "musicNavigationButtonRenderer")
      if (r == null) continue
      var parsed = parseFun(r)
      if (parsed != null) out.add(parsed)
    }
    return out
  }
}
