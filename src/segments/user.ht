// ─────────────────────────────────────────────────────────────────────────────
//  src/segments/user.ht
//  UserEndpoint — user profile + personal library (liked songs, playlists …)
//  All methods require a valid cookie session (the user must be signed in).
// ─────────────────────────────────────────────────────────────────────────────
import "../utils/api.ht"
import "../utils/parser.ht"
import "module:spotube_plugin" as spotube

class UserEndpoint {
  var client

  construct(this.client) {}

  fun _cookies() {
    return getStoredCookies()
  }

  fun _post(endpoint, body) {
    return _cookies().then((cookies) {
      return ytPost(client, endpoint, body, cookies)
    })
  }

  // ── me() — returns SpotubeUserObject ─────────────────────────────────────
  fun me() {
    return _cookies().then((cookies) {
      return client.get(
        "https://www.googleapis.com/oauth2/v3/userinfo",
        headers: makeHeaders(cookies)
      ).then((resp) {
        if (resp == null) return null

        var images = []
        var pic = resp["picture"]
        if (pic != null && pic != "") {
          images.add({"url": pic, "width": 96, "height": 96})
        }

        return {
          "id":           resp["sub"]   ?? "unknown",
          "display_name": resp["name"]  ?? "YouTube Music User",
          "images":       images,
          "email":        resp["email"]
        }
      })
    })
  }

  // ── savedTracks() ─────────────────────────────────────────────────────────
  fun savedTracks({offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 50

    return _post("browse", {"browseId": BROWSE_LIKED_SONGS}).then((resp) {
      if (resp == null) return makePagination([], 0, offset, limit, null)
      var items = _extractShelfTracks(resp, offset, limit)
      return makePagination(items, items.length + offset, offset, limit, null)
    })
  }

  // ── savedPlaylists() ──────────────────────────────────────────────────────
  fun savedPlaylists({offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 50

    return _post("browse", {"browseId": BROWSE_LIKED_PLAYLISTS}).then((resp) {
      if (resp == null) return makePagination([], 0, offset, limit, null)
      var items = _extractGridItems(resp, parsePlaylist, offset, limit)
      return makePagination(items, items.length + offset, offset, limit, null)
    })
  }

  // ── savedAlbums() ─────────────────────────────────────────────────────────
  fun savedAlbums({offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 50

    return _post("browse", {"browseId": BROWSE_LIBRARY_ALBUMS}).then((resp) {
      if (resp == null) return makePagination([], 0, offset, limit, null)
      var items = _extractGridItems(resp, parseAlbum, offset, limit)
      return makePagination(items, items.length + offset, offset, limit, null)
    })
  }

  // ── savedArtists() ────────────────────────────────────────────────────────
  fun savedArtists({offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 50

    return _post("browse", {"browseId": BROWSE_LIBRARY_ARTISTS}).then((resp) {
      if (resp == null) return makePagination([], 0, offset, limit, null)
      var items = _extractGridItems(resp, parseArtist, offset, limit)
      return makePagination(items, items.length + offset, offset, limit, null)
    })
  }

  // ── Presence checks ───────────────────────────────────────────────────────
  fun isSavedPlaylist(playlistId) {
    return spotube.Future.value(false)
  }

  // FIX: was trackIds.map((_) => false).toList() — arrow functions and
  //      .toList() are not valid in Hetu. Use explicit for-each loops.
  fun isSavedTracks(trackIds) {
    var results = []
    for (var _ in trackIds) {
      results.add(false)
    }
    return spotube.Future.value(results)
  }

  fun isSavedAlbums(albumIds) {
    var results = []
    for (var _ in albumIds) {
      results.add(false)
    }
    return spotube.Future.value(results)
  }

  fun isSavedArtists(artistIds) {
    var results = []
    for (var _ in artistIds) {
      results.add(false)
    }
    return spotube.Future.value(results)
  }

  // ── Private helpers ───────────────────────────────────────────────────────

  fun _extractShelfTracks(resp, offset, limit) {
    var tracks   = []
    var sections = getSectionContents(resp)
    if (sections == null) return tracks

    for (var section in sections) {
      var shelf = safeGet(section, "musicShelfRenderer")
      if (shelf == null) continue
      var contents = safeGet(shelf, "contents") ?? []

      // FIX: for(i; ...) and for(; ...) are both invalid Hetu syntax.
      //      Use while loop instead.
      var i   = offset < contents.length ? offset : contents.length
      var end = (offset + limit) < contents.length ? (offset + limit) : contents.length

      while (i < end) {
        var renderer = safeGet(contents[i], "musicResponsiveListItemRenderer")
        if (renderer != null) {
          var track = parseTrack(renderer)
          if (track != null) tracks.add(track)
        }
        i = i + 1
      }
      break
    }

    return tracks
  }

  fun _extractGridItems(resp, parseFun, offset, limit) {
    var out      = []
    var sections = getSectionContents(resp)
    if (sections == null) return out

    for (var section in sections) {
      // gridRenderer (albums / playlists view)
      var grid = safeGet(section, "gridRenderer")
      if (grid != null) {
        var gridItems = safeGet(grid, "items") ?? []
        // FIX: use while loop
        var i   = offset < gridItems.length ? offset : gridItems.length
        var end = (offset + limit) < gridItems.length ? (offset + limit) : gridItems.length

        while (i < end) {
          var tmp = safeGet(gridItems[i], "musicTwoRowItemRenderer")
          var r   = tmp != null ? tmp : safeGet(gridItems[i], "musicResponsiveListItemRenderer")
          if (r != null) {
            var parsed = parseFun(r)
            if (parsed != null) out.add(parsed)
          }
          i = i + 1
        }
        break
      }

      // musicShelfRenderer fallback
      var shelf = safeGet(section, "musicShelfRenderer")
      if (shelf != null) {
        var contents = safeGet(shelf, "contents") ?? []
        // FIX: use while loop
        var i   = offset < contents.length ? offset : contents.length
        var end = (offset + limit) < contents.length ? (offset + limit) : contents.length

        while (i < end) {
          var tmp = safeGet(contents[i], "musicResponsiveListItemRenderer")
          var r   = tmp != null ? tmp : safeGet(contents[i], "musicTwoRowItemRenderer")
          if (r != null) {
            var parsed = parseFun(r)
            if (parsed != null) out.add(parsed)
          }
          i = i + 1
        }
        break
      }
    }

    return out
  }
}
