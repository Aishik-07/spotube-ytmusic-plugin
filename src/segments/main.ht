// ─────────────────────────────────────────────────────────────────────────────
//  src/segments/main.ht
//  The main entry point for the YouTube Music Spotube Plugin
// ─────────────────────────────────────────────────────────────────────────────
import "module:spotube_plugin" as spotube

// Import all the segment files you created
import "auth.ht"
import "album.ht"
import "artist.ht"
import "track.ht"
import "user.ht"

// The class name must match the "entryPoint" defined in plugin.json
class YoutubeMusic {
  var client
  
  // Define variables for all your endpoints
  var auth
  var album
  var artist
  var track
  var user

  construct() {
    // Initialize the shared HTTP client provided by Spotube
    client = spotube.HttpClient()
    
    // Instantiate all your endpoint classes, passing the client to them
    auth   = AuthEndpoint(client)
    album  = AlbumEndpoint(client)
    artist = ArtistEndpoint(client)
    track  = TrackEndpoint(client)
    user   = UserEndpoint(client)
  }
}

