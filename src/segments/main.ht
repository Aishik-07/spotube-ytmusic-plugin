// src/segments/main.ht
import "module:spotube_plugin" as spotube

import "auth.ht"
import "user.ht"
import "track.ht"
import "album.ht"
import "artist.ht"
import "playlist.ht"
import "search.ht"
import "browse.ht"
import "core.ht"

class YoutubeMusic {
  var client
  var auth
  var user
  var track
  var album
  var artist
  var playlist
  var search
  var browse
  var core

  // Spotube creates the HttpClient and passes it here.
  // Do NOT call spotube.HttpClient() — it does not exist.
  construct(this.client) {
    auth     = AuthEndpoint(client)
    user     = UserEndpoint(client)
    track    = TrackEndpoint(client)
    album    = AlbumEndpoint(client)
    artist   = ArtistEndpoint(client)
    playlist = PlaylistEndpoint(client)
    search   = SearchEndpoint(client)
    browse   = BrowseEndpoint(client)
    core     = CorePlugin(client)
  }
}

