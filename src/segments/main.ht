// src/segments/main.ht
import "module:spotube_plugin" as spotube

import "auth.ht"
import "user.ht"
import "track.ht"
import "album.ht"
import "artist.ht"
import "playlist.ht"
import "search.ht"
import "browse.ht"
import "core.ht"

class YoutubeMusic {
  var auth
  var user
  var track
  var album
  var artist
  var playlist
  var search
  var browse
  var core

  var client

  // Spotube calls construct() with NO arguments.
  // HttpClient and HttpBaseOptions are globally available from hetu_std —
  // do NOT prefix them with spotube. or std.
  construct() {
    client   = HttpClient(HttpBaseOptions(baseUrl: "https://music.youtube.com"))
    auth     = AuthEndpoint(client)
    user     = UserEndpoint(client)
    track    = TrackEndpoint(client)
    album    = AlbumEndpoint(client)
    artist   = ArtistEndpoint(client)
    playlist = PlaylistEndpoint(client)
    search   = SearchEndpoint(client)
    browse   = BrowseEndpoint(client)
    core     = CorePlugin(client)
  }
}

