// ─────────────────────────────────────────────────────────────────────────────
//  src/segments/core.ht
//  CorePlugin — update checker and support info
// ─────────────────────────────────────────────────────────────────────────────
import "../utils/api.ht"

class CorePlugin {
  var client
  var _repo = "Aishik-07/spotube-ytmusic-plugin"

  construct(this.client) {}

  // ── checkUpdate(currentConfig) ────────────────────────────────────────────
  //  Returns { downloadUrl, version, changelog } if an update is available,
  //  null otherwise.
  fun checkUpdate(currentConfig) {
    var currentVersion = currentConfig["version"] ?? "1.0.0"
    var versionParts   = currentVersion.split(".")
    if (versionParts.length < 3) return null

    var currentMajor = int.parse(versionParts[0])
    var currentMinor = int.parse(versionParts[1])
    var currentPatch = int.parse(versionParts[2])

    var url = "https://api.github.com/repos/${_repo}/releases/latest"
    return client.get(url, headers: {"Accept": "application/vnd.github.v3+json"}).then((data) {
      if (data == null) return null
      var latestVersion = data["tag_name"] ?? ""
      var parts = latestVersion.split(".")
      if (parts.length < 3) return null

      var latestMajor = int.parse(parts[0])
      var latestMinor = int.parse(parts[1])
      var latestPatch = int.parse(parts[2])

      var isUpdateAvailable =
        latestMajor > currentMajor ||
        (latestMajor == currentMajor && latestMinor > currentMinor) ||
        (latestMajor == currentMajor && latestMinor == currentMinor && latestPatch > currentPatch)

      if (!isUpdateAvailable) return null

      var assets = data["assets"] ?? []
      var downloadUrl = null
      for (var asset in assets) {
        var name = asset["name"] ?? ""
        if (name == "plugin.smplug") {
          downloadUrl = asset["browser_download_url"]
          break
        }
      }

      if (downloadUrl == null) return null

      var changelog = data["body"] ?? "No changelog available"
      return {
        "downloadUrl": downloadUrl,
        "version":     latestVersion,
        "changelog":   changelog
      }
    })
  }

  // ── support (getter) ──────────────────────────────────────────────────────
  get support {
    return " YouTube Music for Spotube. Features: search, browse, liked songs, playlists, albums, artists, radio, Google account sign-in. Limitations: isSaved checks return false, artist follow/album save not available via API. Report issues: https://github.com/Aishik-07/spotube-ytmusic-plugin/issues"
  }

  // ── scrobble — no-op (not supported by YouTube Music) ─────────────────────
  fun scrobble(details) {
    return null
  }
}
