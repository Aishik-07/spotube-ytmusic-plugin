// ─────────────────────────────────────────────────────────────────────────────
//  src/segments/album.ht
//  AlbumEndpoint — full album pages, paginated tracks, new-release charts
// ─────────────────────────────────────────────────────────────────────────────
import "../utils/api.ht"
import "../utils/parser.ht"

class AlbumEndpoint {
  var client

  construct(this.client) {}

  fun _cookies() { return getStoredCookies() }

  // ── getAlbum(id) → SpotubeFullAlbumObject ────────────────────────────────
  fun getAlbum(id) {
    return _cookies().then((cookies) {
      return ytPost(client, "browse", {"browseId": id}, cookies).then((resp) {
        if (resp == null) return null
        return _parseAlbumPage(resp, id)
      })
    })
  }

  // ── tracks(id, {offset, limit}) ───────────────────────────────────────────
  fun tracks(id, {offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 50

    return getAlbum(id).then((album) {
      if (album == null) return makePagination([], 0, offset, limit, null)
      var all  = safeGet(safeGet(album, "tracks"), "items") ?? []
      var page = _slice(all, offset, limit)
      return makePagination(page, all.length, offset, limit, null)
    })
  }

  // ── releases({offset, limit}) ─────────────────────────────────────────────
  fun releases({offset, limit}) {
    offset = offset ?? 0
    limit  = limit  ?? 20

    return _cookies().then((cookies) {
      return ytPost(client, "browse", {"browseId": BROWSE_CHARTS}, cookies).then((resp) {
        if (resp == null) return makePagination([], 0, offset, limit, null)
        var items = _extractAlbumsFromBrowse(resp, offset, limit)
        return makePagination(items, items.length + offset, offset, limit, null)
      })
    })
  }

  fun save(albumIds)   { return null }
  fun unsave(albumIds) { return null }

  // ── Private helpers ───────────────────────────────────────────────────────

  fun _parseAlbumPage(resp, id) {
    var header = safeGet(resp, "header")
    var hdr    = safeGet(header, "musicImmersiveHeaderRenderer")
             ?? safeGet(header, "musicDetailHeaderRenderer")
    if (hdr == null) return null

    var title   = textFromRuns(safeGet(safeGet(hdr, "title"), "runs")) ?? "Unknown Album"
    var subRuns = safeGet(safeGet(hdr, "subtitle"), "runs") ?? []

    var artists   = []
    var year      = null
    var albumType = "album"

    for (var run in subRuns) {
      var text    = run["text"] ?? ""
      var trimmed = text.trim()
      if (trimmed == "•" || trimmed == " " || trimmed == "") continue

      var ep = safeGet(run, "navigationEndpoint")
      if (ep != null) {
        var bid = safeGet(safeGet(ep, "browseEndpoint"), "browseId") ?? ""
        if (bid.startsWith("UC") || bid.startsWith("MPLA")) {
          artists.add({
            "id":   bid,
            "name": trimmed,
            "images": [],
            "external_urls": {"youtube": "https://music.youtube.com/channel/${bid}"}
          })
        }
      } else {
        if (trimmed.length == 4) {
          var y = int.parse(trimmed)
          if (y > 1900 && y < 2100) year = trimmed
        } else if (trimmed.toLowerCase() == "single") {
          albumType = "single"
        } else if (trimmed.toLowerCase() == "ep") {
          albumType = "ep"
        }
      }
    }

    var images      = parseThumbnails(safeGet(hdr, "thumbnail") ?? safeGet(hdr, "thumbnailCropped"))
    var albumTracks = _parseAlbumTracks(resp)

    return {
      "id":           id,
      "name":         title,
      "release_date": year,
      "total_tracks": albumTracks.length,
      "images":       images,
      "artists":      artists,
      "album_type":   albumType,
      "tracks":       makePagination(albumTracks, albumTracks.length, 0, albumTracks.length, null),
      "external_urls": {"youtube": "https://music.youtube.com/browse/${id}"}
    }
  }

  fun _parseAlbumTracks(resp) {
    var tracks   = []
    var sections = getSectionContents(resp)
    if (sections == null) return tracks

    for (var section in sections) {
      var shelf    = safeGet(section, "musicShelfRenderer")
      if (shelf == null) continue
      var contents = safeGet(shelf, "contents") ?? []
      for (var item in contents) {
        var r = safeGet(item, "musicResponsiveListItemRenderer")
        if (r == null) continue
        var t = parseTrack(r)
        if (t != null) tracks.add(t)
      }
      break
    }
    return tracks
  }

  fun _extractAlbumsFromBrowse(resp, offset, limit) {
    var albums   = []
    var sections = getSectionContents(resp)
    if (sections == null) return albums

    for (var section in sections) {
      var carousel = safeGet(section, "musicCarouselShelfRenderer")
      if (carousel == null) continue
      var hdr    = safeGet(safeGet(carousel, "header"), "musicCarouselShelfBasicHeaderRenderer")
      var hTitle = textFromRuns(safeGet(safeGet(hdr, "title"), "runs")) ?? ""
      var lt     = hTitle.toLowerCase()
      if (!lt.contains("new") && !lt.contains("album") && !lt.contains("release")) continue

      var contents = safeGet(carousel, "contents") ?? []
      // FIX: for(i; ...) is invalid Hetu syntax — use while loop
      var i   = offset < contents.length ? offset : contents.length
      var end = (offset + limit) < contents.length ? (offset + limit) : contents.length

      while (i < end) {
        var r = safeGet(contents[i], "musicTwoRowItemRenderer")
        if (r != null) {
          var a = parseAlbum(r)
          if (a != null) albums.add(a)
        }
        i = i + 1
      }
      break
    }
    return albums
  }

  fun _slice(list, offset, limit) {
    var out = []
    // FIX: for(i; ...) is invalid Hetu syntax — use while loop
    var i   = offset < list.length ? offset : list.length
    var end = (offset + limit) < list.length ? (offset + limit) : list.length
    while (i < end) {
      out.add(list[i])
      i = i + 1
    }
    return out
  }
}
